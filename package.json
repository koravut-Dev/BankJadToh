{
  "name": "bank",
  "productName": "Bank JadToh",
  "version": "0.1.0",
  "description": "แบงค์ จัดโต๊ะ - smart, automatic desktop & file organizer for Windows",
  "main": "src/main/main.js",
  "author": "Bank JadToh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "app.bank.desktop",
    "productName": "Bank JadToh",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "แบงค์ จัดโต๊ะ"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
