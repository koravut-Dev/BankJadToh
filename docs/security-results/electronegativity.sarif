{
  "$schema": "http://json.schemastore.org/sarif-2.1.0",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "version": "1.10.3",
          "informationUri": "https://github.com/doyensec/electronegativity",
          "name": "Electronegativity",
          "fullName": "Electronegativity is a tool to identify misconfigurations and security anti-patterns in Electron applications",
          "rules": [
            {
              "id": "AVAILABLE_SECURITY_FIXES_GLOBAL_CHECK",
              "fullDescription": {
                "text": "Check if there are security patches applied in between the Electron version used and the latest"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/AVAILABLE_SECURITY_FIXES_GLOBAL_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/AVAILABLE_SECURITY_FIXES_GLOBAL_CHECK"
              }
            },
            {
              "id": "CSP_GLOBAL_CHECK",
              "fullDescription": {
                "text": "One or more CSP directives detected seems to be vulnerable"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/CSP_GLOBAL_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/CSP_GLOBAL_CHECK"
              }
            },
            {
              "id": "PRELOAD_JS_CHECK",
              "fullDescription": {
                "text": "Review the use of preload scripts"
              },
              "properties": {
                "category": "Security"
              },
              "helpUri": "https://github.com/doyensec/electronegativity/wiki/PRELOAD_JS_CHECK",
              "help": {
                "text": "https://github.com/doyensec/electronegativity/wiki/PRELOAD_JS_CHECK"
              }
            }
          ]
        }
      },
